datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  
  // --- ELVORIA CUSTOM DATA ---
  role          String    @default("USER") // Can be "USER" or "ADMIN"
  coins         Int       @default(0)
  loginStreak   Int       @default(0)
  lastLogin     DateTime  @default(now())
  panelPassword String?
  servers       Server[]  // Servers this user owns
}



model Node {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   
  location    String   
  ram         Int      // <-- CHANGED FROM ramTotal TO MATCH ADMIN PANEL
  ramUsed     Int      @default(0)
  maxServers  Int      @default(20)
  
  servers     Server[]
}

model Settings {
  id               String @id @default(auto()) @map("_id") @db.ObjectId
  pteroUrl         String @default("")
  pteroApiKey      String @default("")
  mcRam            Int    @default(2048)
  botRam           Int    @default(512)
  storage          Int    @default(5120)
  adLink           String @default("")
  adCoins          Int    @default(15)
  maxServers       Int    @default(3)
  suspendHours     Int    @default(24)
  
  // NEW GRIM REAPER TIMER
  deleteAfterHours Int    @default(48) // Deletes server completely after 48h of suspension
}

model Egg {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  pteroNestId Int
  pteroEggId  Int
  price       Int      @default(10)
  ram         Int      @default(1024)
  cpu         Int      @default(100)
  disk        Int      @default(5120)
  
  // NEW ADMIN LIMITS
  backups     Int      @default(1)
  allocations Int      @default(1)
  databases   Int      @default(1)
  cpuPinning  String   @default("")  // e.g., "1", "1-4", or leave empty

  servers     Server[]
}

model Server {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  status      String    @default("installing")
  suspended   Boolean   @default(false)
  pteroId     Int?
  
  // NEW SUSPENSION TIMESTAMP (Tells the Grim Reaper when to strike)
  suspendedAt DateTime?

  eggId       String    @db.ObjectId
  userId      String    @db.ObjectId
  nodeId      String    @db.ObjectId

  user        User      @relation(fields: [userId], references: [id])
  node        Node      @relation(fields: [nodeId], references: [id])
  egg         Egg       @relation(fields: [eggId], references: [id])
}
